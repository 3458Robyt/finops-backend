# Infrastructure values; keep the real .env.beta outside Git (chmod 600).
POSTGRES_DB=finops_beta
POSTGRES_PASSWORD=replace_with_64_char_url_safe_random_secret
FINOPS_RUNTIME_DB_PASSWORD=replace_with_a_different_64_char_url_safe_secret
# Configure this DSN only in private deployment secrets; never commit credentials.
MIGRATION_DATABASE_URL=
CORS_ORIGIN=http://localhost:18443,http://127.0.0.1:18443,http://localhost:5173

# SMTP opcional: configura la dirección/contraseña únicamente en .env.beta.runtime (permisos 600), no aquí ni en Git. Gmail/Yahoo pueden inferir el servidor.
EMAIL_ENABLED=false
EMAIL_ADDRESS=
EMAIL_PASSWORD=
SMTP_HOST=
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_FROM_NAME=FinOps Inteligente
PASSWORD_RESET_URL=http://localhost:5173/reset-password

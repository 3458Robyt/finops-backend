# ═══════════════════════════════════════════════════════════════
# FinOps Inteligente — Variables de Entorno
# ═══════════════════════════════════════════════════════════════

# ── AWS ──
AWS_ACCESS_KEY_ID=your_access_key
AWS_SECRET_ACCESS_KEY=your_secret_key
AWS_REGION=us-east-1

# ── Oracle Cloud (OCI) ──
OCI_TENANCY_OCID=ocid1.tenancy.oc1..xxxxx
OCI_USER_OCID=ocid1.user.oc1..xxxxx
OCI_FINGERPRINT=xx:xx:xx:xx:xx:xx:xx:xx:xx:xx:xx:xx:xx:xx:xx:xx
OCI_PRIVATE_KEY_PATH=/path/to/oci_api_key.pem
OCI_REGION=us-ashburn-1
ENABLE_OCI_PROVIDER=false

# ── PostgreSQL local / Supabase ──
# Desarrollo local recomendado después del clon: PostgreSQL 17 nativo en
# 127.0.0.1:5433/finops_local. No guardes la contraseña en este archivo.
DATABASE_URL=postgresql://user:password@localhost:5432/finops
# Obligatorio en produccion: todas las consultas usan el rol RLS dedicado.
DB_RUNTIME_ENFORCE=false
DB_RUNTIME_ROLE=finops_runtime
# En produccion debe coincidir con la última migración desplegada.
DB_EXPECTED_MIGRATION=202609150001_readiness_summary_indexes

# ── API / Seguridad ──
NODE_ENV=development
PORT=3000
CORS_ORIGIN=http://localhost:5173
HTTP_BODY_LIMIT=1mb
# Trust proxy solo cuando existe un reverse proxy controlado delante del backend.
TRUST_PROXY=false
HTTP_REQUEST_TIMEOUT_MS=120000
HTTP_HEADERS_TIMEOUT_MS=15000
HTTP_KEEP_ALIVE_TIMEOUT_MS=5000
API_RATE_LIMIT_PER_MINUTE=600
AI_RATE_LIMIT_PER_MINUTE=30
FINOPS_REQUIRED_TAG_KEYS=environment,owner,application,cost_center
JWT_SECRET=replace_with_at_least_32_random_characters
JWT_ISSUER=finops-backend
JWT_AUDIENCE=finops-app
JWT_EXPIRES_IN_SECONDS=900
# Refresh opaco de un solo uso. El valor crudo solo viaja en cookie HttpOnly.
AUTH_REFRESH_TOKEN_TTL_SECONDS=2592000
AUTH_COOKIE_SAME_SITE=lax
PASSWORD_RESET_TTL_SECONDS=900
PASSWORD_RESET_URL=http://localhost:5173/reset-password
CLIENT_PORTAL_URL=http://localhost:5173
MFA_REQUIRED_FOR_PRIVILEGED=false
METRICS_TOKEN=
# Roles válidos: api, worker, scheduler, ingestion-worker, learning-worker,
# recommendation-analysis-worker, savings-reconciliation-worker,
# ingestion-scheduler,
# recommendation-analysis-scheduler,
# notification-scheduler, auth-cleanup-scheduler, budget-scheduler o all.
APP_PROCESS_ROLE=all

# Base64 de 32 bytes. Generar con:
# node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
CREDENTIAL_ENCRYPTION_KEY=replace_with_base64_32_byte_key
CREDENTIAL_KEY_VERSION=v1
SEED_DEFAULT_PASSWORD=[demo password removed]
FOCUS_SAMPLE_CSV_URL=https://raw.githubusercontent.com/FinOps-Open-Cost-and-Usage-Spec/FOCUS-Sample-Data/main/FOCUS-1.0/focus_sample_10000.csv

# Worker persistente de ingesta SDK. Ejecuta una pasada al arrancar y luego por intervalo,
# sin solapar iteraciones si un job tarda mas que el intervalo.
INGESTION_WORKER_ENABLED=false
INGESTION_WORKER_ID=finops-worker-local
INGESTION_WORKER_INTERVAL_MS=1000
INGESTION_WORKER_CONCURRENCY=4
INGESTION_JOB_RETRY_BACKOFF_MS=5000
INGESTION_JOB_PROGRESS_UPDATE_MS=2000
INGESTION_JOB_LEASE_MS=300000
INGESTION_JOB_HEARTBEAT_MS=60000

# Proyección asíncrona de resúmenes y rollups técnicos. El job raw no espera
# esta fase; se procesa en segundo plano con lease y reintentos acotados.
METRIC_PROJECTION_WORKER_ENABLED=false
METRIC_PROJECTION_WORKER_ID=finops-metric-projection-local
METRIC_PROJECTION_WORKER_INTERVAL_MS=1000
METRIC_PROJECTION_LEASE_MS=300000
METRIC_PROJECTION_RETRY_BACKOFF_MS=5000
METRIC_PROJECTION_TRANSACTION_TIMEOUT_MS=120000

# Centro de realización de valor. Manual está disponible siempre; estos flags
# activan conciliación automática posterior a una ingesta y canales externos.
SAVINGS_RECONCILIATION_ENABLED=false
SAVINGS_RECONCILIATION_BATCH_SIZE=50
SAVINGS_RECONCILIATION_TENANT_ID=replace_with_tenant_id
SAVINGS_RECONCILIATION_RUN_ON_START=false
SAVINGS_RECONCILIATION_SCHEDULER_ENABLED=false
SAVINGS_RECONCILIATION_INTERVAL_MS=300000
VALUE_REALIZATION_OUTBOUND_ENABLED=false

# Scheduler persistente de jobs. Encola jobs y el worker los procesa.
INGESTION_SCHEDULER_ENABLED=false
INGESTION_SCHEDULER_INTERVAL_MS=300000
INGESTION_SCHEDULER_INVENTORY_WINDOW_HOURS=24
INGESTION_SCHEDULER_INVENTORY_COOLDOWN_HOURS=24
INGESTION_SCHEDULER_METRIC_WINDOW_MINUTES=30
INGESTION_SCHEDULER_METRIC_COOLDOWN_MINUTES=25
INGESTION_SCHEDULER_BILLING_WINDOW_HOURS=24
INGESTION_SCHEDULER_BILLING_COOLDOWN_HOURS=6
INGESTION_SCHEDULER_MAX_ATTEMPTS=3
# Histórico técnico máximo que el scheduler recupera automáticamente (OCI: 90 días)
INGESTION_SCHEDULER_METRIC_CATCHUP_DAYS=90
INGESTION_SCHEDULER_METRIC_CATCHUP_WINDOW_MINUTES=1440
INGESTION_SCHEDULER_MAX_METRIC_BACKFILL_JOBS_PER_CONNECTION=48
FX_TRM_ENDPOINT=https://www.datos.gov.co/resource/32sa-8pi3.json
FX_TRM_TIMEOUT_MS=10000
INGESTION_SCHEDULER_VALIDATION_MAX_AGE_MINUTES=1440
# Opcional: limitar scheduling a proveedor/conexion especifica.
# INGESTION_SCHEDULER_PROVIDER=oci
# INGESTION_SCHEDULER_CONNECTION_ID=cloud_connection_id

# ── OpenAI-compatible AI API ──
# AI_* es la única configuración soportada para el proveedor compatible con OpenAI.
AI_API_KEY=replace_with_openai_compatible_key
AI_BASE_URL=https://api.example.com/v1
AI_MODEL=gpt-5.6-luna
AI_AUDITOR_MODEL=gpt-5.6-luna
AI_TIMEOUT_MS=60000
AI_MAX_RETRIES=1
# Opcionales: permiten estimar costo de tokens en el reporte de calidad IA.
AI_INPUT_COST_PER_MILLION_TOKENS_USD=
AI_OUTPUT_COST_PER_MILLION_TOKENS_USD=

# ── Ajustes opcionales del agente / analítica ──
# Tiempo máximo (ms) que espera el auditor de aprendizaje antes de omitir (SKIPPED).
LEARNING_AUDIT_TIMEOUT_MS=15000
AGENT_LEARNING_WORKER_ENABLED=false
AGENT_LEARNING_WORKER_ID=finops-learning-local
AGENT_LEARNING_WORKER_INTERVAL_MS=5000
AGENT_LEARNING_LEASE_MS=60000
# Worker durable de corridas FinOps. Puede desactivarse sin afectar chat o consultas.
RECOMMENDATION_ANALYSIS_WORKER_ENABLED=false
RECOMMENDATION_ANALYSIS_WORKER_ID=finops-analysis-local
RECOMMENDATION_ANALYSIS_WORKER_INTERVAL_MS=5000
RECOMMENDATION_ANALYSIS_WORKER_STALE_AFTER_MS=1800000
# El scheduler automático queda apagado durante desarrollo.
RECOMMENDATION_ANALYSIS_SCHEDULER_ENABLED=false
RECOMMENDATION_ANALYSIS_SCHEDULER_INTERVAL_MS=300000
RECOMMENDATION_ANALYSIS_SCHEDULER_COOLDOWN_MINUTES=30
# Limpieza acotada de sesiones y credenciales efímeras; solo se ejecuta en scheduler.
AUTH_CLEANUP_SCHEDULER_ENABLED=false
AUTH_CLEANUP_SCHEDULER_INTERVAL_MS=21600000
AUTH_CLEANUP_BATCH_SIZE=500

# Evaluación periódica de presupuestos. Opt-in y tenant-scoped.
BUDGET_SCHEDULER_ENABLED=false
BUDGET_SCHEDULER_TENANT_ID=replace_with_tenant_id
BUDGET_SCHEDULER_USER_ID=replace_with_admin_user_id
BUDGET_SCHEDULER_INTERVAL_MS=300000
# Heartbeat durable de procesos API/worker/scheduler para observabilidad operativa.
PROCESS_HEARTBEAT_ENABLED=true
PROCESS_HEARTBEAT_INTERVAL_MS=30000
PROCESS_HEARTBEAT_STALE_AFTER_MS=90000
# Delta mínimo en USD para que una desviación de costo se considere oportunidad.
ANOMALY_MIN_DELTA_USD=1

# ── Telegram Bot ──
# Límite para solicitudes SMTP y Telegram; evita bloquear workers por proveedores lentos.
OUTBOUND_PROVIDER_TIMEOUT_MS=15000
TELEGRAM_ENABLED=false
TELEGRAM_BOT_TOKEN=replace_with_botfather_token
TELEGRAM_WEBHOOK_SECRET=replace_with_random_webhook_secret
TELEGRAM_BOT_USERNAME=replace_with_bot_username_without_at
TELEGRAM_INBOUND_WORKER_ENABLED=false
TELEGRAM_INBOUND_WORKER_ID=telegram-inbound-local
TELEGRAM_INBOUND_WORKER_INTERVAL_MS=1000
TELEGRAM_INBOUND_WORKER_LEASE_MS=120000
TELEGRAM_INBOUND_WORKER_RETRY_BACKOFF_MS=5000

# ── Correo SMTP ──
EMAIL_ENABLED=false
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_POOL_ENABLED=true
SMTP_MAX_CONNECTIONS=3
SMTP_MAX_MESSAGES=100
SMTP_RATE_LIMIT=20
SMTP_USER=replace_with_email
SMTP_PASSWORD=replace_with_app_password
SMTP_FROM=replace_with_email
SMTP_FROM_NAME=FinOps Inteligente

# ── Mensajeria externa / scheduler ──
MESSAGE_SCHEDULER_ENABLED=false
MESSAGE_SCHEDULER_INTERVAL_MINUTES=1440
MESSAGE_SCHEDULER_TENANT_ID=replace_with_tenant_id
MESSAGE_SCHEDULER_USER_ID=replace_with_admin_user_id
MESSAGE_SCHEDULER_DELIVERY_BATCH_SIZE=50
MESSAGE_SCHEDULER_DELIVERY_LEASE_MS=120000
MESSAGE_SCHEDULER_DELIVERY_RETRY_BACKOFF_MS=30000

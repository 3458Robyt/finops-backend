  tenant          Tenant                @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  createdBy       User?                 @relation("ContextBuildRunCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)

  @@index([tenantId, status, createdAt])
  @@index([createdByUserId], map: "context_build_runs_created_by_user_id_idx")
  @@map("context_build_runs")
}

model TelegramChatLink {
  id               String                 @id @default(cuid())
  tenantId         String                 @map("tenant_id")
  userId           String                 @map("user_id")
  chatId           String                 @map("chat_id")
  telegramUserId   String?                @map("telegram_user_id")
  telegramUsername String?                @map("telegram_username")
  status           TelegramChatLinkStatus @default(ACTIVE)
  linkedByUserId   String                 @map("linked_by_user_id")
  disabledAt       DateTime?              @map("disabled_at") @db.Timestamptz(6)
  createdAt        DateTime               @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime               @updatedAt @map("updated_at") @db.Timestamptz(6)
  tenant           Tenant                 @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user             User                   @relation("TelegramChatLinkUser", fields: [userId], references: [id], onDelete: Cascade)
  linkedBy         User                   @relation("TelegramChatLinkLinkedBy", fields: [linkedByUserId], references: [id], onDelete: Restrict)

  @@unique([chatId])
  @@unique([tenantId, userId, chatId])
  @@index([tenantId, status])
  @@index([userId, status])
  @@index([linkedByUserId], map: "telegram_chat_links_linked_by_user_id_idx")
  @@map("telegram_chat_links")
}

model TelegramLinkCode {
  id         String    @id @default(cuid())
  tenantId   String    @map("tenant_id")
  userId     String    @map("user_id")
  tokenHash  String    @unique @map("token_hash") @db.VarChar(64)
  expiresAt  DateTime  @map("expires_at") @db.Timestamptz(6)
  consumedAt DateTime? @map("consumed_at") @db.Timestamptz(6)
  revokedAt  DateTime? @map("revoked_at") @db.Timestamptz(6)
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  tenant     Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([tenantId, userId, expiresAt, consumedAt])
  @@map("telegram_link_codes")
}

model TelegramInteractionLog {
  id               String                    @id @default(cuid())
  tenantId         String?                   @map("tenant_id")
  userId           String?                   @map("user_id")
  chatId           String                    @map("chat_id")
  telegramUserId   String?                   @map("telegram_user_id")
  telegramUsername String?                   @map("telegram_username")
  command          String?
  status           TelegramInteractionStatus
  textPreview      String?                   @map("text_preview") @db.VarChar(240)
  errorMessage     String?                   @map("error_message") @db.Text
  metadata         Json?
  createdAt        DateTime                  @default(now()) @map("created_at") @db.Timestamptz(6)
  tenant           Tenant?                   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user             User?                     @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([tenantId, userId, createdAt])
  @@index([chatId, createdAt])
  @@index([status, createdAt])
  @@index([userId], map: "telegram_interaction_logs_user_id_idx")
  @@map("telegram_interaction_logs")
}

model OutboundMessageDelivery {
  id                String                 @id @default(cuid())
  tenantId          String                 @map("tenant_id")
  userId            String?                @map("user_id")
  recommendationId  String?                @map("recommendation_id")
  channel           OutboundMessageChannel
  messageType       OutboundMessageType    @map("message_type")
  status            OutboundMessageStatus  @default(PENDING)
  subject           String?
  preview           String                 @db.Text
  body              String                 @db.Text
  providerMessageId String?                @map("provider_message_id")
  errorMessage      String?                @map("error_message") @db.Text
  metadata          Json?
  sentAt            DateTime?              @map("sent_at") @db.Timestamptz(6)
  attemptCount      Int                    @default(0) @map("attempt_count")
  maxAttempts       Int                    @default(3) @map("max_attempts")
  nextAttemptAt     DateTime               @default(now()) @map("next_attempt_at") @db.Timestamptz(6)
  lockedAt          DateTime?              @map("locked_at") @db.Timestamptz(6)
  lockedBy          String?                @map("locked_by")
  createdAt         DateTime               @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime               @updatedAt @map("updated_at") @db.Timestamptz(6)
  tenant            Tenant                 @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user              User?                  @relation(fields: [userId], references: [id], onDelete: SetNull)
  recommendation    Recommendation?        @relation(fields: [recommendationId], references: [id], onDelete: SetNull)

  @@index([tenantId, channel, status, createdAt])
  @@index([tenantId, status, nextAttemptAt, lockedAt, createdAt])
  @@index([userId, createdAt])
  @@index([recommendationId, createdAt])
  @@map("outbound_message_deliveries")
}

model AuditEvent {
  id          String   @id @default(cuid())
  tenantId    String   @map("tenant_id")
  actorUserId String?  @map("actor_user_id")
  action      String
  entityType  String   @map("entity_type")
  entityId    String?  @map("entity_id")
  metadata    Json?
  ipAddress   String?  @map("ip_address")
  userAgent   String?  @map("user_agent")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  actorUser   User?    @relation(fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([tenantId, createdAt])
  @@index([actorUserId, createdAt])
  @@index([entityType, entityId])
  @@map("audit_events")
}

model RuntimeProcessHeartbeat {
  processId       String    @id @map("process_id")
  processRole     String    @map("process_role")
  status          String    @default("RUNNING")
  pid             Int?
  startedAt       DateTime  @map("started_at") @db.Timestamptz(6)
  lastHeartbeatAt DateTime  @map("last_heartbeat_at") @db.Timestamptz(6)
  stoppedAt       DateTime? @map("stopped_at") @db.Timestamptz(6)
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([processRole, status, lastHeartbeatAt])
  @@map("runtime_process_heartbeats")
}

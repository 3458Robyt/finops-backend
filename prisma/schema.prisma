generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum TenantStatus {
  ACTIVE
  SUSPENDED
}

enum UserRole {
  ADMIN
  MASTER_ADMIN
  VIEWER
  OPERATOR_ADMIN
  FINOPS_TECHNICIAN
  CLIENT_APPROVER
  CLIENT_VIEWER
}

enum UserStatus {
  ACTIVE
  DISABLED
}

enum MfaChallengePurpose {
  LOGIN
  ENROLLMENT
}

enum CloudProvider {
  AWS
  OCI
  AZURE
  GCP
  CUSTOM
}

enum MetricStatistic {
  MEAN
  MIN
  MAX
  P50
  P90
  P95
  P99
  SUM
  COUNT
  RATE
  LATEST
}

enum CloudAccountStatus {
  ACTIVE
  DISABLED
}

enum IngestionStatus {
  RUNNING
  SUCCESS
  FAILED
}

enum TenantAccessRole {
  TECHNICIAN
  LEAD_TECHNICIAN
  OPERATOR_ADMIN
}

enum ProviderCapability {
  FOCUS_EXPORT
  CROSS_ACCOUNT_DELIVERY
  INVENTORY
  TECHNICAL_METRICS
  OPTIONAL_AGENTS
}

enum CredentialPurpose {
  TEMPORARY_ADMIN
  OPERATIONAL
  BILLING_EXPORT_READ
  INVENTORY_READ
  METRICS_READ
  STORAGE_READ
  STORAGE_WRITE
}

enum CredentialStatus {
  PENDING
  ACTIVE
  DISABLED
  REVOKED
  EXPIRED
  INVALID
}

enum IngestionJobStatus {
  PENDING
  RUNNING
  SUCCESS
  FAILED
  CANCELLED
  SKIPPED
}

enum MetricProjectionStatus {
  NOT_REQUIRED
  PENDING
  RUNNING
  SUCCESS
  FAILED
}

enum MetricCoverageStatus {
  UNKNOWN
  COVERED
  PARTIAL
  NO_DATA
  FAILED
}

enum IngestionDataOutcome {
  DATA_WRITTEN
  NO_DATA
  PARTIAL
  INVALID_CONFIGURATION
  PROVIDER_ERROR
}

enum IngestionSourceType {
  BILLING_EXPORT
  INVENTORY
  TECHNICAL_METRIC
  AGENT_METRIC
}

enum DataQualityStatus {
  PASSED
  WARNING
  FAILED
}

enum CloudResourceStatus {
  ACTIVE
  STOPPED
  TERMINATED
  UNKNOWN
}

enum AgentInstallationStatus {
  NOT_INSTALLED
  INSTALLED
  DISABLED
  UNKNOWN
}

enum RecommendationStatus {
  PENDING
  APPROVED
  REJECTED
  MANUAL_COMPLETED
}

enum RecommendationSeverity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum RecommendationDecisionType {
  APPROVED
  REJECTED
  MARKED_DONE
}

enum RecommendationFeedbackReason {
  APPROVED_HIGH_CONFIDENCE
  APPROVED_LOW_RISK_QUICK_WIN
  REJECTED_INSUFFICIENT_EVIDENCE
  REJECTED_SAVINGS_UNREALISTIC
  REJECTED_OPERATIONAL_RISK
  REJECTED_BUSINESS_EXCEPTION
  REJECTED_ALREADY_HANDLED
  REJECTED_WRONG_SCOPE
  REJECTED_NOT_ACTIONABLE
}

enum AiAuditVerdict {
  APPROVED
  REJECTED
  NEEDS_REVISION
}

enum AgentLearningStatus {
  PENDING
  APPROVED
  REJECTED
  SKIPPED
  ERROR
}

enum SavingsMeasurementStatus {
  WAITING_FOR_DATA
  READY
  CALCULATED
  INSUFFICIENT_EVIDENCE
  VERIFIED
  REJECTED
  FAILED
}

enum SavingsMeasurementScope {
  RESOURCE
  SERVICE
  ACCOUNT
  UNKNOWN
}

enum AgentMemoryScope {
  LOCAL
  GLOBAL
}

enum AgentMemoryType {
  RULE
  LESSON
  APPROVAL_PATTERN
  REJECTION_PATTERN
  DECISION_PATTERN
}

enum CostAnomalySeverity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum CostAnomalyStatus {
  OPEN
  LINKED_TO_RECOMMENDATION
  RESOLVED
}

enum InAppNotificationType {
  SAVINGS_REMINDER
  BUDGET_ALERT
  RECOMMENDATION_ANALYSIS_COMPLETED
}

enum RecommendationAnalysisRunStatus {
  PENDING
  RUNNING
  COMPLETED
  PARTIAL
  SKIPPED
  FAILED
  CANCELLED
}

enum RecommendationAnalysisRunStage {
  QUEUED
  SELECTING_DATA
  DETERMINISTIC_ANALYSIS
  EVIDENCE_GATE
  AI_GENERATION
  AI_AUDIT
  PERSISTENCE
  NOTIFICATION
  FINISHED
}

enum RecommendationAnalysisTrigger {
  MANUAL
  SCHEDULED
  POST_INGESTION
  RETRY
}

enum RecommendationAnalysisScope {
  TENANT
  RESOURCE
}

enum RecommendationAnalysisRecommendationDisposition {
  CREATED
  REUSED
}

enum BudgetScope {
  TENANT
  CLOUD_ACCOUNT
  SERVICE
  ALLOCATION_DESTINATION
}

enum BudgetStatus {
  ACTIVE
  ARCHIVED
}

enum BudgetAlertLevel {
  WARNING
  CRITICAL
  EXCEEDED
}

enum CostAllocationRuleStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

enum CostAllocationMode {
  DIRECT
  SPLIT
}

enum CostAllocationClosureStatus {
  CLOSED
  REPLACED
}

enum CostBillingSource {
  FOCUS
  PROVIDER_API
  LEGACY
  UNKNOWN
}

enum InAppNotificationStatus {
  UNREAD
  READ
  DISMISSED
}

enum AgentInstructionProfileStatus {
  DRAFT
  ACTIVE
  ARCHIVED
  REJECTED
}

enum TenantAgentRuleStatus {
  ACTIVE
  DISABLED
}

enum AiContextOperation {
  CHAT
  RECOMMENDATION
  EXECUTION_PLAN
  AUDIT
  LEARNING
}

enum ContextBuildRunStatus {
  PENDING
  RUNNING
  SUCCESS
  FAILED
}

enum TelegramChatLinkStatus {
  ACTIVE
  DISABLED
}

enum TelegramInteractionStatus {
  PROCESSED
  IGNORED
  ERROR
}

enum OutboundMessageChannel {
  TELEGRAM
  EMAIL
}

enum OutboundMessageType {
  TEST
  CLIENT_INVITATION
  SAVINGS_REMINDER
  AI_CHAT_RESPONSE
  RECOMMENDATION_SUMMARY
  EXECUTION_PLAN_READY
  BUDGET_ALERT
  EXECUTIVE_SUMMARY
}

enum OutboundMessageStatus {
  PENDING
  PROCESSING
  SENT
  FAILED
  SKIPPED
}

enum ManualExecutionStatus {
  PLANNED
  EXECUTED
  PARTIAL
  CANCELLED
}

model Tenant {
  id                            String                             @id @default(cuid())
  operatorOrganizationId        String?                            @map("operator_organization_id")
  name                          String
  slug                          String                             @unique
  reportingCurrency             String                             @default("USD") @map("reporting_currency") @db.VarChar(3)
  status                        TenantStatus                       @default(ACTIVE)
  createdAt                     DateTime                           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt                     DateTime                           @updatedAt @map("updated_at") @db.Timestamptz(6)
  users                         User[]
  cloudAccounts                 CloudAccount[]
  ingestionRuns                 IngestionRun[]
  costMetrics                   CostMetric[]
  recommendations               Recommendation[]
  auditEvents                   AuditEvent[]
  operatorOrganization          OperatorOrganization?              @relation(fields: [operatorOrganizationId], references: [id], onDelete: SetNull)
  accessAssignments             TenantAccessAssignment[]
  cloudConnections              CloudConnection[]
  cloudConnectionRegions        CloudConnectionRegion[]
  cloudMetricDefinitions        CloudMetricDefinition[]
  operatorStorageLocations      OperatorStorageLocation[]
  ingestionJobs                 IngestionJob[]
  ingestionJobParts             IngestionJobPart[]
  ingestionCoverageSegments     IngestionCoverageSegment[]
  metricCoverageWindows         ResourceMetricCoverageWindow[]
  ingestionObjects              IngestionObject[]
  ingestionWatermarks           IngestionWatermark[]
  focusCostLineItems            FocusCostLineItem[]
  cloudResources                CloudResource[]
  resourceMetricSamples         ResourceMetricSample[]
  resourceMetricStreamSummaries ResourceMetricStreamSummary[]
  agentInstallations            AgentInstallation[]
  dataQualityChecks             DataQualityCheck[]
  agentLearningEvents           AgentLearningEvent[]
  agentMemories                 AgentMemory[]
  tenantAgentRules              TenantAgentRule[]
  agentInstructionAuditEvents   AgentInstructionAuditEvent[]
  contextSummaryCaches          ContextSummaryCache[]
  aiContextTraces               AiContextTrace[]
  contextBuildRuns              ContextBuildRun[]
  telegramChatLinks             TelegramChatLink[]
  telegramLinkCodes             TelegramLinkCode[]
  telegramInteractionLogs       TelegramInteractionLog[]
  costAnomalies                 CostAnomaly[]
  costForecasts                 CostForecast[]
  manualExecutions              RecommendationManualExecution[]
  savingsMeasurements           RecommendationSavingsMeasurement[]
  inAppNotifications            InAppNotification[]
  outboundMessageDeliveries     OutboundMessageDelivery[]
  budgets                       Budget[]
  budgetAlerts                  BudgetAlert[]
  costAllocationRules           CostAllocationRule[]
  costAllocationRuleTargets     CostAllocationRuleTarget[]
  costAllocationClosures        CostAllocationClosure[]
  costAllocationClosureLines    CostAllocationClosureLine[]
  recommendationAnalysisRuns    RecommendationAnalysisRun[]
  authSessions                  AuthSession[]
  authRefreshTokens             AuthRefreshToken[]
  clientInvitations             ClientInvitation[]

  @@index([operatorOrganizationId, status])
  @@map("tenants")
}

model FxRate {
  id            String    @id @default(cuid())
  baseCurrency  String    @map("base_currency") @db.VarChar(3)
  quoteCurrency String    @map("quote_currency") @db.VarChar(3)
  rate          Decimal   @db.Decimal(24, 12)
  validFrom     DateTime  @map("valid_from") @db.Date
  validTo       DateTime? @map("valid_to") @db.Date
  source        String
  sourceUrl     String?   @map("source_url")
  retrievedAt   DateTime  @default(now()) @map("retrieved_at") @db.Timestamptz(6)
  metadata      Json?

  @@unique([baseCurrency, quoteCurrency, validFrom, source], map: "fx_rates_pair_date_source_key")
  @@index([baseCurrency, quoteCurrency, validFrom, validTo], map: "fx_rates_lookup_idx")
  @@map("fx_rates")
}

model User {
  id                                  String                             @id @default(cuid())
  operatorOrganizationId              String?                            @map("operator_organization_id")
  tenantId                            String                             @map("tenant_id")
  email                               String                             @unique
  name                                String
  passwordHash                        String                             @map("password_hash")
  role                                UserRole                           @default(VIEWER)
  status                              UserStatus                         @default(ACTIVE)
  lastLoginAt                         DateTime?                          @map("last_login_at") @db.Timestamptz(6)
  createdAt                           DateTime                           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt                           DateTime                           @updatedAt @map("updated_at") @db.Timestamptz(6)
  tenant                              Tenant                             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  sessions                            AuthSession[]
  refreshTokens                       AuthRefreshToken[]
  passwordResetTokens                 PasswordResetToken[]
  mfaChallenges                       MfaChallenge[]
  mfa                                 UserMfa?
  mfaRecoveryCodes                    MfaRecoveryCode[]
  decisions                           RecommendationDecision[]
  executionPlans                      RecommendationExecutionPlan[]
  manualExecutions                    RecommendationManualExecution[]
  requestedSavingsMeasurements        RecommendationSavingsMeasurement[] @relation("SavingsMeasurementRequestedBy")
  verifiedSavingsMeasurements         RecommendationSavingsMeasurement[] @relation("SavingsMeasurementVerifiedBy")
  auditEvents                         AuditEvent[]
  operatorOrganization                OperatorOrganization?              @relation(fields: [operatorOrganizationId], references: [id], onDelete: SetNull)
  tenantAccessAssignments             TenantAccessAssignment[]
  generatedIngestionJobs              IngestionJob[]                     @relation("IngestionJobRequestedBy")
  cancelledIngestionJobs              IngestionJob[]                     @relation("IngestionJobCancelRequestedBy")
  archivedIngestionJobs               IngestionJob[]                     @relation("IngestionJobArchivedBy")
  generatedDataQualityChecks          DataQualityCheck[]                 @relation("DataQualityCheckCreatedBy")
  agentLearningEvents                 AgentLearningEvent[]
  inAppNotifications                  InAppNotification[]
  createdAgentInstructionProfiles     AgentInstructionProfile[]          @relation("AgentInstructionProfileCreatedBy")
  activatedAgentInstructionProfiles   AgentInstructionProfile[]          @relation("AgentInstructionProfileActivatedBy")
  createdTenantAgentRules             TenantAgentRule[]                  @relation("TenantAgentRuleCreatedBy")
  agentInstructionAuditEvents         AgentInstructionAuditEvent[]       @relation("AgentInstructionAuditActor")
  aiContextTraces                     AiContextTrace[]
  createdContextBuildRuns             ContextBuildRun[]                  @relation("ContextBuildRunCreatedBy")
  telegramChatLinks                   TelegramChatLink[]                 @relation("TelegramChatLinkUser")
  linkedTelegramChatLinks             TelegramChatLink[]                 @relation("TelegramChatLinkLinkedBy")
  telegramLinkCodes                   TelegramLinkCode[]
  telegramInteractionLogs             TelegramInteractionLog[]
  outboundMessageDeliveries           OutboundMessageDelivery[]
  createdBudgets                      Budget[]                           @relation("BudgetCreatedBy")
  createdCostAllocationRules          CostAllocationRule[]               @relation("CostAllocationRuleCreatedBy")
  closedCostAllocationClosures        CostAllocationClosure[]            @relation("CostAllocationClosureClosedBy")
  requestedRecommendationAnalysisRuns RecommendationAnalysisRun[]        @relation("RecommendationAnalysisRunRequestedBy")
  createdClientInvitations            ClientInvitation[]                 @relation("ClientInvitationCreatedBy")

  @@index([operatorOrganizationId, role])
  @@index([tenantId, role])
  @@map("users")
}

model OperatorOrganization {
  id        String       @id @default(cuid())
  name      String
  slug      String       @unique
  status    TenantStatus @default(ACTIVE)
  createdAt DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)
  tenants   Tenant[]
  users     User[]

  @@map("operator_organizations")
}

model TenantAccessAssignment {
  id         String           @id @default(cuid())
  tenantId   String           @map("tenant_id")
  userId     String           @map("user_id")
  role       TenantAccessRole @default(TECHNICIAN)
  createdAt  DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  disabledAt DateTime?        @map("disabled_at") @db.Timestamptz(6)
  tenant     Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user       User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([tenantId, userId])
  @@index([userId, disabledAt])
  @@index([tenantId, role])
  @@map("tenant_access_assignments")
}

model ClientInvitation {
  id              String    @id @default(cuid())
  tenantId        String    @map("tenant_id")
  createdByUserId String    @map("created_by_user_id")
  email           String
  invitedName     String?   @map("invited_name")
  role            UserRole  @default(CLIENT_VIEWER)
  tokenHash       String    @unique @map("token_hash") @db.VarChar(64)
  expiresAt       DateTime  @map("expires_at") @db.Timestamptz(6)
  consumedAt      DateTime? @map("consumed_at") @db.Timestamptz(6)
  revokedAt       DateTime? @map("revoked_at") @db.Timestamptz(6)
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  tenant    Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  createdBy User   @relation("ClientInvitationCreatedBy", fields: [createdByUserId], references: [id], onDelete: Restrict)

  @@index([tenantId, expiresAt, consumedAt])
  @@index([email, consumedAt])
  @@map("client_invitations")
}

model ProviderCatalog {
  code                String               @id
  displayName         String               @map("display_name")
  provider            CloudProvider
  capabilities        ProviderCapability[]
  defaultFocusVersion String?              @map("default_focus_version")
  documentationUrl    String?              @map("documentation_url")
  enabled             Boolean              @default(true)
  createdAt           DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime             @updatedAt @map("updated_at") @db.Timestamptz(6)
  cloudConnections    CloudConnection[]

  @@index([provider, enabled])
  @@map("provider_catalog")
}

model CloudConnection {
  id                            String                         @id @default(cuid())
  tenantId                      String                         @map("tenant_id")
  providerCode                  String                         @map("provider_code")
  rootExternalId                String                         @map("root_external_id")
  name                          String
  status                        CloudAccountStatus             @default(ACTIVE)
  defaultRegion                 String?                        @map("default_region")
  metadata                      Json?
  lastValidatedAt               DateTime?                      @map("last_validated_at") @db.Timestamptz(6)
  lastValidationAttemptAt       DateTime?                      @map("last_validation_attempt_at") @db.Timestamptz(6)
  createdAt                     DateTime                       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt                     DateTime                       @updatedAt @map("updated_at") @db.Timestamptz(6)
  tenant                        Tenant                         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  providerCatalog               ProviderCatalog                @relation(fields: [providerCode], references: [code], onDelete: Restrict)
  credentials                   CloudConnectionCredential[]
  exportConfigs                 CloudExportConfig[]
  ingestionJobs                 IngestionJob[]
  ingestionJobParts             IngestionJobPart[]
  ingestionCoverageSegments     IngestionCoverageSegment[]
  ingestionRuns                 IngestionRun[]
  ingestionObjects              IngestionObject[]
  ingestionWatermarks           IngestionWatermark[]
  ingestionRegions              CloudConnectionRegion[]
  metricDefinitions             CloudMetricDefinition[]
  metricCoverageWindows         ResourceMetricCoverageWindow[]
  focusCostLineItems            FocusCostLineItem[]
  cloudResources                CloudResource[]
  resourceMetricSamples         ResourceMetricSample[]
  resourceMetricStreamSummaries ResourceMetricStreamSummary[]
  costMetrics                   CostMetric[]
  agentInstallations            AgentInstallation[]
  dataQualityChecks             DataQualityCheck[]

  @@unique([tenantId, providerCode, rootExternalId])
  @@index([tenantId, status])
  @@index([providerCode, status])
  @@map("cloud_connections")
}

model CloudConnectionCredential {
  id                    String            @id @default(cuid())
  cloudConnectionId     String            @map("cloud_connection_id")
  purpose               CredentialPurpose
  status                CredentialStatus  @default(ACTIVE)
  label                 String
  encryptedPayload      String            @map("encrypted_payload") @db.Text
  encryptionIv          String            @map("encryption_iv")
  encryptionAuthTag     String            @map("encryption_auth_tag")
  encryptionAlgorithm   String            @default("aes-256-gcm") @map("encryption_algorithm")
  encryptionKeyVersion  String            @default("v1") @map("encryption_key_version")
  externalPrincipalId   String?           @map("external_principal_id")
  keyFingerprint        String?           @map("key_fingerprint")
  expiresAt             DateTime?         @map("expires_at") @db.Timestamptz(6)
  createdAt             DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  disabledAt            DateTime?         @map("disabled_at") @db.Timestamptz(6)
  revokedAt             DateTime?         @map("revoked_at") @db.Timestamptz(6)
  validationStatus      String?           @map("validation_status")
  validationMessage     String?           @map("validation_message") @db.Text
  validationAttemptedAt DateTime?         @map("validation_attempted_at") @db.Timestamptz(6)
  cloudConnection       CloudConnection   @relation(fields: [cloudConnectionId], references: [id], onDelete: Cascade)

  @@index([cloudConnectionId, purpose, status])
  @@index([cloudConnectionId, purpose, keyFingerprint])
  @@index([expiresAt])
  @@map("cloud_connection_credentials")
}

model OperatorStorageLocation {
  id            String              @id @default(cuid())
  tenantId      String              @map("tenant_id")
  provider      String              @default("s3-compatible")
  bucketName    String              @map("bucket_name")
  basePrefix    String              @map("base_prefix")
  kmsKeyRef     String?             @map("kms_key_ref")
  retentionDays Int                 @default(730) @map("retention_days")
  createdAt     DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime            @updatedAt @map("updated_at") @db.Timestamptz(6)
  tenant        Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  exportConfigs CloudExportConfig[]

  @@unique([tenantId, bucketName])
  @@map("operator_storage_locations")
}

model CloudExportConfig {
  id                String                   @id @default(cuid())
  cloudConnectionId String                   @map("cloud_connection_id")
  storageLocationId String?                  @map("storage_location_id")
  sourceType        IngestionSourceType      @default(BILLING_EXPORT) @map("source_type")
  focusVersion      String?                  @map("focus_version")
  externalExportId  String?                  @map("external_export_id")
  exportPath        String?                  @map("export_path")
  schedule          String                   @default("daily")
  status            CloudAccountStatus       @default(ACTIVE)
  lastDeliveredAt   DateTime?                @map("last_delivered_at") @db.Timestamptz(6)
  createdAt         DateTime                 @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime                 @updatedAt @map("updated_at") @db.Timestamptz(6)
  cloudConnection   CloudConnection          @relation(fields: [cloudConnectionId], references: [id], onDelete: Cascade)
  storageLocation   OperatorStorageLocation? @relation(fields: [storageLocationId], references: [id], onDelete: SetNull)
  ingestionObjects  IngestionObject[]

  @@index([cloudConnectionId, sourceType, status])
  @@index([storageLocationId], map: "cloud_export_configs_storage_location_id_idx")
  @@map("cloud_export_configs")
}

model AuthSession {
  id            String             @id @default(cuid())
  userId        String             @map("user_id")
  tenantId      String             @map("tenant_id")
  jwtId         String             @unique @map("jwt_id")
  issuedAt      DateTime           @default(now()) @map("issued_at") @db.Timestamptz(6)
  expiresAt     DateTime           @map("expires_at") @db.Timestamptz(6)
  revokedAt     DateTime?          @map("revoked_at") @db.Timestamptz(6)
  ipAddress     String?            @map("ip_address")
  userAgent     String?            @map("user_agent")
  user          User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  tenant        Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  refreshTokens AuthRefreshToken[]

  @@index([userId, expiresAt])
  @@index([tenantId, revokedAt])
  @@index([expiresAt], map: "auth_sessions_expires_at_idx")
  @@map("auth_sessions")
}

model AuthRefreshToken {
  id        String      @id @default(cuid())
  sessionId String      @map("session_id")
  userId    String      @map("user_id")
  tenantId  String      @map("tenant_id")
  familyId  String      @map("family_id")
  tokenHash String      @unique @map("token_hash")
  issuedAt  DateTime    @default(now()) @map("issued_at") @db.Timestamptz(6)
  expiresAt DateTime    @map("expires_at") @db.Timestamptz(6)
  usedAt    DateTime?   @map("used_at") @db.Timestamptz(6)
  revokedAt DateTime?   @map("revoked_at") @db.Timestamptz(6)
  ipAddress String?     @map("ip_address")
  userAgent String?     @map("user_agent")
  session   AuthSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  tenant    Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([sessionId, revokedAt])
  @@index([userId, revokedAt, expiresAt])
  @@index([familyId, revokedAt])
  @@index([tenantId], map: "auth_refresh_tokens_tenant_id_idx")
  @@index([expiresAt], map: "auth_refresh_tokens_expires_at_idx")
  @@map("auth_refresh_tokens")
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String    @map("user_id")
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(6)
  usedAt    DateTime? @map("used_at") @db.Timestamptz(6)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  ipAddress String?   @map("ip_address")
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
  @@index([expiresAt], map: "password_reset_tokens_expires_at_idx")
  @@map("password_reset_tokens")
}

model UserMfa {
  id                   String    @id @default(cuid())
  userId               String    @unique @map("user_id")
  encryptedSecret      String    @map("encrypted_secret") @db.Text
  encryptionIv         String    @map("encryption_iv")
  encryptionAuthTag    String    @map("encryption_auth_tag")
  encryptionAlgorithm  String    @default("aes-256-gcm") @map("encryption_algorithm")
  encryptionKeyVersion String    @default("v1") @map("encryption_key_version")
  enabledAt            DateTime? @map("enabled_at") @db.Timestamptz(6)
  lastUsedStep         BigInt?   @map("last_used_step")

{
  "name": "finops-backend",
  "version": "1.0.0",
  "description": "FinOps Inteligente - Backend Core para optimización de costos multicloud (FinOps Demo)",
  "main": "dist/index.js",
  "type": "module",
  "scripts": {
    "build": "prisma generate && tsc && node -e \"const fs=require('node:fs'); fs.rmSync('dist/generated/prisma', { recursive: true, force: true }); fs.cpSync('src/generated/prisma', 'dist/generated/prisma', { recursive: true })\"",
    "predev": "prisma generate",
    "dev": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/local/run-local.ps1 -Mode dev",
    "dev:api": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "typecheck": "prisma generate && tsc --noEmit",
    "check:architecture": "node scripts/check-architecture.mjs",
    "check:release-hygiene": "node scripts/check-release-hygiene.mjs",
    "test": "vitest run",
    "test:unit": "vitest run --exclude=src/testing/**/*.integration.test.ts",
    "test:integration": "node scripts/testing/run-integration-tests.mjs",
    "test:integration:isolated": "tsx scripts/testing/isolated-integration-suite.ts",
    "test:integration:agent-quality": "tsx scripts/testing/agent-quality-integration.ts",
    "test:integration:auth-cleanup": "tsx scripts/testing/auth-lifecycle-cleanup-integration.ts",
    "test:integration:process-heartbeat": "tsx scripts/testing/process-heartbeat-integration.ts",
    "test:integration:docker": "docker compose -f docker-compose.test.yml up -d --wait && cross-env DATABASE_URL=postgresql://finops:finops@localhost:55432/finops_test prisma migrate deploy && cross-env TEST_DATABASE_URL=postgresql://finops:finops@localhost:55432/finops_test ALLOW_DESTRUCTIVE_TEST_DATABASE=true RUN_DB_INTEGRATION_TESTS=true vitest run src/testing/e2eFixtures.test.ts src/testing/**/*.integration.test.ts",
    "test:integration:resource-lineage": "tsx scripts/testing/resource-linkage-integration.ts",
    "test:integration:cost-allocation": "tsx scripts/testing/cost-allocation-integration.ts",
    "test:api:smoke": "tsx scripts/testing/api-smoke.ts",
    "test:api:smoke:isolated": "tsx scripts/testing/isolated-api-smoke.ts",
    "test:api:onboarding": "tsx scripts/testing/cloud-onboarding-api-smoke.ts",
    "test:canary:runtime-rls": "tsx scripts/testing/runtime-rls-canary.ts",
    "test:canary:ai": "tsx scripts/testing/ai-live-canary.ts",
    "test:canary:ai:gpt56": "tsx scripts/testing/ai-gpt56-coherence.ts",
    "test:canary:tak-chat": "tsx scripts/testing/canary privado no incluido en el repositorio p?blico",
    "test:canary:learning": "cross-env AI_CANARY_SCOPE=learning tsx scripts/testing/ai-live-canary.ts",
    "test:ai:offline": "vitest run src/application/services/ai/evaluation",
    "test:ai:live": "npm run build && cross-env AI_CANARY_SCOPE=finops tsx scripts/testing/ai-live-canary.ts",
    "test:perf:technical-metrics": "tsx scripts/testing/technical-metrics-perf.ts",
    "test:perf:value-realization": "tsx scripts/testing/value-realization-perf.ts",
    "db:verify:quality-indexes": "tsx scripts/verify-quality-report-indexes.ts",
    "test:fixtures:value-realization-benchmark": "tsx scripts/testing/seed-value-realization-benchmark.ts",
    "test:canary:oci-onboarding": "tsx scripts/testing/oci-onboarding-canary.ts",
    "test:canary:oci-metric-discovery": "tsx scripts/testing/oci-metric-discovery-readonly-canary.ts",
    "test:canary:oci-gap": "tsx scripts/testing/oci-gap-readonly-canary.ts",
    "test:canary:messaging": "tsx scripts/testing/messaging-live-canary.ts",
    "test:fixtures:prepare": "tsx scripts/testing/prepare-e2e-schema.ts",
    "test:fixtures:create": "tsx scripts/testing/create-e2e-fixtures.ts",
    "test:fixtures:cleanup": "tsx scripts/testing/cleanup-e2e-fixtures.ts",
    "test:all": "npm run check:architecture && npm run check:release-hygiene && npm run typecheck && npm run test:unit && npm run test:ai:offline && npm run build",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:studio": "prisma studio",
    "db:seed": "tsx prisma/seed.ts",
    "db:local:start": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/local/start-postgres17.ps1",
    "db:local:stop": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/local/start-postgres17.ps1 -Stop",
    "db:local:clone": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/local/clone-supabase-finops.ps1 -Force",
    "dev:local": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/local/run-local.ps1 -Mode dev",
    "ingestion:local:worker": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/local/run-local.ps1 -Mode worker",
    "recommendations:local:worker": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/local/run-local.ps1 -Mode analysis-worker",
    "ingestion:local:scheduler": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/local/run-local.ps1 -Mode scheduler",
    "import:oci-focus": "tsx scripts/import-oci-focus.ts",
    "fx:backfill": "tsx scripts/backfill-fx-rates.ts",
    "aws:register-role": "tsx scripts/register-aws-role-credential.ts",
    "ingestion:configure-focus": "tsx scripts/configure-focus-source.ts",
    "ingestion:doctor": "tsx scripts/check-ingestion-readiness.ts",
    "ingestion:create-job": "tsx scripts/create-ingestion-job.ts",
    "ingestion:schedule": "tsx scripts/schedule-ingestion-jobs.ts",
    "ingestion:audit": "tsx scripts/audit-ingestion-range.ts",
    "ingestion:worker:once": "tsx scripts/run-ingestion-worker-once.ts",
    "metrics:projection:once": "tsx scripts/run-metric-projection-once.ts",
    "ingestion:worker:preflight": "tsx scripts/run-ingestion-worker-once.ts --preflight",
    "ingestion:preview-focus": "tsx scripts/preview-focus-sources.ts",
    "db:reconcile:resource-links": "tsx scripts/reconcile-resource-links.ts",
    "oci:register-profile": "tsx scripts/register-oci-profile-credential.ts",
    "oci:prepare-metrics": "tsx scripts/prepare-oci-technical-metrics.ts",
    "oci:confirm-metrics": "tsx scripts/confirm-oci-technical-metrics.ts",
    "oci:validate-connection": "tsx scripts/validate-oci-connection.ts",
    "oci:validate-credential": "tsx scripts/validate-oci-credential.ts",
    "oci:backfill-metrics": "tsx scripts/queue-oci-technical-backfill.ts",
    "metrics:rebuild-stream-summaries": "tsx scripts/rebuild-metric-stream-summaries.ts",
    "metrics:rebuild-rollups": "tsx scripts/rebuild-resource-metric-rollups.ts",
    "metrics:rebuild-coverage": "tsx scripts/rebuild-metric-coverage.ts",
    "metrics:reproject-filtered-coverage": "tsx scripts/reproject-filtered-metric-coverage.ts",
    "oci:reconcile-credentials": "tsx scripts/reconcile-cloud-credential-validation.ts",
    "oci:reconcile-fingerprints": "tsx scripts/reconcile-cloud-credential-fingerprints.ts",
    "telegram:set-webhook": "tsx scripts/telegram-set-webhook.ts",
    "users:consolidate-admin-tenants": "tsx scripts/consolidate-admin-tenants.ts",
    "maintenance:cleanup-development-artifacts": "tsx scripts/maintenance/cleanup-development-artifacts.ts"
  },
  "keywords": [
    "finops",
    "cloud-cost",
    "multicloud",
    "aws",
    "oci",
    "timescaledb"
  ],
  "author": "FinOps Demo",
  "license": "UNLICENSED",
  "dependencies": {
    "@aws-sdk/client-cloudwatch": "^3.1062.0",
    "@aws-sdk/client-cost-explorer": "^3.750.0",
    "@aws-sdk/client-ec2": "^3.1073.0",
    "@aws-sdk/client-s3": "^3.1062.0",
    "@aws-sdk/client-sts": "^3.1062.0",
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "argon2": "^0.44.0",
    "cors": "^2.8.5",
    "csv-parse": "^7.0.2",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "helmet": "^8.2.0",
    "jsonwebtoken": "^9.0.3",
    "nodemailer": "^10.0.9",
    "oci-common": "^2.138.0",
    "oci-core": "^2.138.0",
    "oci-identity": "^2.138.0",
    "oci-monitoring": "^2.138.0",
    "oci-objectstorage": "^2.138.0",
    "oci-resourcesearch": "^2.138.0",
    "oci-usageapi": "^2.138.0",
    "openai": "^6.35.0",
    "pg": "^8.20.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^22.13.10",
    "@types/nodemailer": "^8.0.1",
    "@types/pg": "^8.20.0",
    "cross-env": "^10.1.0",
    "prisma": "^7.10.0",
    "tsx": "^4.23.13",
    "typescript": "^5.7.3",
    "vitest": "^4.1.5"
  },
  "overrides": {
    "deepmerge-ts": "8.0.2",
    "esbuild": "0.28.2",
    "mysql2": "3.24.3",
    "qs": "6.16.0"
  }
}
